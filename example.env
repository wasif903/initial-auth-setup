NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/nutryx
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_SECONDS=3600
JWT_REFRESH_EXPIRES_DAYS=30
DEFAULT_PASSWORDLESS_OTP=123456
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.yourcompany.nutryx
ADMIN_EMAILS=admin1@gmail.com,admin2@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-google-account@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM=Nutryx <your-google-account@gmail.com>

META_WHATSAPP_API_VERSION=vXX.X
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
META_WHATSAPP_OTP_TEMPLATE_NAME=your-approved-authentication-template
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US

OTP_PEPPER=replace-with-a-random-secret-at-least-32-characters-long
OTP_EXPIRY_MINUTES=10
RESET_TOKEN_EXPIRY_MINUTES=15
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Passwordless auth uses DEFAULT_PASSWORDLESS_OTP for now.
# Replace this with generated OTP delivery when OneSignal is integrated.
# Social providers supported by the API: google, apple.
